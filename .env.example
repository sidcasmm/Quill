# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mini-medium.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mini-medium
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-mini-medium.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# Local only. On Vercel leave this unset (or false) so Auth/Firestore hit production.
NEXT_PUBLIC_USE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Public site metadata
NEXT_PUBLIC_SITE_NAME=Quill
NEXT_PUBLIC_SITE_DESCRIPTION=A place for writers to publish stories, and for readers to find them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PAYOUT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_WRITER_PERCENT=50

# AdSense (keep ENABLED=false while developing; no live ads will render)
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_END=
NEXT_PUBLIC_ADSENSE_TEST=true
